[Unit]
Description=Smart Boiler Room edge agent
Documentation=https://git.mayanext.com/mehrab_ghw/boilerRoom-edge
# The agent runs fine without a network — it falls back to its cached schedule
# and retries login in the background — so this is a preference, not a hard
# dependency. Nothing here should stop the boilers running their programme.
After=network-online.target
Wants=network-online.target

# Keep restarting, but not in a tight loop: five failures in five minutes means
# something restarting will not fix, and hammering an SD card is its own
# problem. The window is long enough that a device failing every few minutes
# keeps being retried rather than being abandoned — this runs heating, and a
# service that has quietly given up is worse than one that is still trying.
# These live in [Unit], not [Service]: systemd moved them in v229.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# The agent's own log is written straight to a file; this is only for the
# startup banner and anything that escapes before logging is configured.
# Unbuffered, or the journal shows nothing until the process ends — which for
# a service meant to run for months means nothing, ever.
Environment=PYTHONUNBUFFERED=1

# Adjust if the checkout or service account differs.
User=pi
Group=pi
WorkingDirectory=/home/pi/boilerRoom-edge
ExecStart=/usr/bin/python3 /home/pi/boilerRoom-edge/src/main.py

# GPIO, SPI and 1-Wire access without running as root.
SupplementaryGroups=gpio spi i2c

# No terminal under systemd. Which of the two that means depends on the build:
#
#   * on the installed device the menu is answered on the matrix keypad and
#     shown on the ST7920 panel, neither of which is a TTY, and disabling it
#     here would leave the operator no way to touch the boilers by hand
#   * on a mock build the menu is answered from a keyboard that is not there,
#     where it would read EOF on stdin, treat it as "operator chose quit", and
#     exit into a restart loop
#
# The isatty() check in menu_enabled() already tells those apart — the keypad
# declares that it needs no terminal, the keyboard declares that it does — so
# there is no override here. Set BOILERROOM_MENU=off to force it off anyway.
StandardInput=null

# The agent writes its own rotating log to data/boilerroom.log. Only the
# startup banner reaches stdout, which the journal keeps.
StandardOutput=journal
StandardError=journal

# SIGTERM is handled: relays are released and SQLite closed before exit.
KillSignal=SIGTERM
TimeoutStopSec=20

Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
