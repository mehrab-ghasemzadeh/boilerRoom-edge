# Copy to .env and fill in the device credentials.
#
# Device credentials — issued by POST /api/v1/devices/provision (digits only).
# Leave both out, or empty, and the device asks for them at the panel the first
# time it boots, then writes them here itself once the server has accepted
# them. That is the point of leaving them out: an installer with a keypad and
# no laptop can still bring a device up.
#
# Nothing is written here until a login has actually succeeded, so a mistyped
# digit is refused on the spot and asked for again rather than cached.
BOILERROOM_DEVICE_USERNAME=8123456789
BOILERROOM_DEVICE_PASSWORD=12345678

# Simulated sensors and relays, or the real ones. Left unset this follows the
# hardware: real on a Raspberry Pi, simulated anywhere else. Set it to force
# one — "on" runs the mocks on a Pi, "off" insists on the hardware and fails at
# startup if RPi.GPIO or spidev is missing rather than quietly simulating.
# BOILERROOM_MOCK_HARDWARE=on

# Server endpoints
BOILERROOM_API_BASE_URL=https://br.mayanext.com
BOILERROOM_WS_BASE_URL=wss://br.mayanext.com

# Optional: pin the id used in REST/WS paths (public_id or serial_number).
# Leave empty to use the device_id returned by the login response.
BOILERROOM_DEVICE_ID=

# Optional: re-login this many seconds before the session token expires.
BOILERROOM_TOKEN_EXPIRY_BUFFER=60

# Temperature limit recovery deadbands, in °C. Ambient has no minimum in the
# server config, so its recovery threshold is max minus this value. The water
# deadband is only used when a config sets a max but no min water temperature.
BOILERROOM_AMBIENT_HYSTERESIS=2.0
BOILERROOM_WATER_DEADBAND=5.0

# Half-band for a boiler the mapping gives a SINGLE probe. That probe reads as
# the boiler's own temperature, so max_water_temperature_c is treated as the
# target it is held at: cut this far above it, restore this far below.
BOILERROOM_SINGLE_PROBE_BAND=3.0

# Cache files for the last config and schedule the server pushed. These let
# the device keep running its heating programme when it boots with no network.
# BOILERROOM_CONFIG_CACHE=config_cache.json
# BOILERROOM_SCHEDULE_CACHE=schedule_cache.json

# Temperature limits edited on the device (control menu, option 10). Kept
# separately from the published config above, so local limits can be discarded
# and the published ones put back. The server's next publish deletes it.
# BOILERROOM_CONFIG_LOCAL=config_local.json

# Per-boiler target temperatures (control menu, option 10). Each boiler's own
# desired_temperature_c, 1-80 C; published to the server with
# boiler.set_temperature. A boiler without one follows the device-wide limit.
# BOILERROOM_SETPOINT_CACHE=setpoint_cache.json

# A programme edited on the device (control menu, option 9). Kept separately
# from the published schedule above, so local edits can be discarded and the
# published one put back. The server's next publish deletes it.
# BOILERROOM_SCHEDULE_LOCAL=schedule_local.json

# Local reading database. Retention 0 disables pruning (the file then grows
# without bound). ~152 bytes/row: 10 sensors at a 10s interval is ~12 MB/day.
BOILERROOM_DATABASE=data/readings.db
BOILERROOM_DATA_RETENTION_DAYS=30

# Logging. Records go to the file only; the terminal is left to the control
# menu. Set CONSOLE_LEVEL to a level name (WARNING/INFO/DEBUG) to also mirror
# records to the terminal while debugging. LOG_LEVEL is the global floor and
# LOG_LEVELS tunes individual subsystems, e.g. ws=DEBUG,telemetry=WARNING.
# Rotation caps growth at MAX_BYTES x (BACKUPS+1).
BOILERROOM_LOG_LEVEL=INFO
# BOILERROOM_LOG_CONSOLE_LEVEL=OFF
# BOILERROOM_LOG_LEVELS=ws=DEBUG,telemetry=WARNING
BOILERROOM_LOG_FILE=data/boilerroom.log
BOILERROOM_LOG_MAX_BYTES=2097152
BOILERROOM_LOG_BACKUPS=3

# Matrix keypad — the control menu's input device on the real hardware, in
# place of a keyboard. Rows are driven, columns are read with the internal
# pull-ups on; which four pins are which is a choice, not a fact, and swapping
# the two lines transposes the layout rather than breaking it.
# BOILERROOM_KEYPAD_ROWS=17,27,22,5     # connector A, B, C, D
# BOILERROOM_KEYPAD_COLS=6,13,19,26     # connector 1, 2, 3, 4
#
# What each position emits, row by row. The default below matches the pad
# fitted to this device, whose caps read 1 2 3 A / 4 5 6 B / 7 8 9 C / * 0 # D:
# "#" accepts, "*" goes back, and A-D take the four remaining functions. On the
# graphical display "2" and "8" also scroll.
#
# A pad wired differently still scans — it just comes out transposed or with
# the wrong caps — so confirm it with `python src/keypad.py --test`, which
# prints the position and token of each key as you press it. Rows are separated
# by "/", keys by ",", and the comma key is therefore spelled "comma" (likewise
# dot, minus, enter, del, cancel).
# BOILERROOM_KEYPAD_LAYOUT=1,2,3,del/4,5,6,dot/7,8,9,comma/cancel,0,enter,minus
#
# What is printed on the caps, in the same positions. Used only to tell the
# operator which key to press — the legend on the display says "# OK", not
# "enter" — so set it if your pad is printed differently.
# BOILERROOM_KEYPAD_CAPS=1,2,3,A/4,5,6,B/7,8,9,C/*,0,#,D
#
# Bench only: restrict the keyboard to the keys the real keypad has, so a
# prompt that cannot be answered on the device shows up before it is on one.
# BOILERROOM_KEYPAD_EMULATE=off

# ST7920 128x64 graphical display, on the SPI header beside the gas ADC:
#   SID -> GPIO10 (MOSI), CLK -> GPIO11 (SCLK), CS -> GPIO7 (CE1), VCC 5V, GND
# Used automatically on the real hardware. PSB on the module must be tied LOW
# for serial mode, and CS on this controller is active HIGH — unlike every
# other SPI device on the header — which is what CS_HIGH below is for. Turn it
# off only if the panel's chip select is strapped high in hardware.
# BOILERROOM_DISPLAY_SPI_BUS=0
# BOILERROOM_DISPLAY_SPI_DEVICE=1
# BOILERROOM_DISPLAY_SPI_SPEED=800000
# BOILERROOM_DISPLAY_CS_HIGH=on
#
# Bench only: draw the panel's screens in the terminal, so the menu an operator
# will actually use can be exercised without the hardware. Type keys as a line
# ("8" moves down, "88#" moves down twice and selects; Enter on its own is #).
# BOILERROOM_DISPLAY=mock

# Device mapping source: "record" (the server device record, default) or
# "file" for bench work with a local mapping document.
BOILERROOM_MAPPING_SOURCE=record
# BOILERROOM_MAPPING=mapping.json   # only used when source=file

# Optional: values reported in device.hello
BOILERROOM_FIRMWARE_VERSION=1.0.0
BOILERROOM_HARDWARE_VERSION=edge-dev
BOILERROOM_WS_RECONNECT_DELAY=5
# Reconnect backoff ceiling, and how long a session must last to reset it.
BOILERROOM_WS_RECONNECT_MAX_DELAY=60
BOILERROOM_WS_SESSION_STABLE=30

# Origin header sent on the WS handshake. The server rejects a handshake with
# no Origin (403). Must be present in the backend's allowed origins.
BOILERROOM_WS_ORIGIN=http://localhost:3000
