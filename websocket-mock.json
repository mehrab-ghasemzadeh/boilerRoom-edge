  "end_to_end_flows": {
    "turn_on_boiler_1": [
      {
        "step": 1,
        "actor": "app",
        "channel": "REST",
        "action": "POST /api/v1/devices/dev-demo-001/commands",
        "see": "commands.boiler.turn_on.http_create"
      },
      {
        "step": 2,
        "actor": "server",
        "channel": "WS device",
        "action": "push command.execute",
        "see": "commands.boiler.turn_on.ws_server_to_device"
      },
      {
        "step": 3,
        "actor": "device",
        "channel": "WS device",
        "action": "send command.ack (received)",
        "see": "commands.boiler.turn_on.ws_device_to_server.ack_received"
      },
      {
        "step": 4,
        "actor": "device",
        "channel": "WS device",
        "action": "send command.ack (executing)",
        "see": "commands.boiler.turn_on.ws_device_to_server.ack_executing"
      },
      {
        "step": 5,
        "actor": "device",
        "channel": "WS device",
        "action": "send command.result (executed)",
        "see": "commands.boiler.turn_on.ws_device_to_server.result_executed"
      },
      {
        "step": 6,
        "actor": "server",
        "channel": "WS app",
        "action": "push command.status_changed",
        "see": "commands.boiler.turn_on.ws_server_to_app.status_executed"
      }
    ],
    "publish_schedule": [
      {
        "step": 1,
        "actor": "app",
        "channel": "REST",
        "action": "POST /api/v1/boiler-rooms/1/schedules",
        "see": "schedules.create_full_week_with_night_setback_and_exceptions.http_create"
      },
      {
        "step": 2,
        "actor": "server",
        "channel": "WS device",
        "action": "push schedule.apply",
        "see": "schedules.create_full_week_with_night_setback_and_exceptions.ws_server_to_device"
      },
      {
        "step": 3,
        "actor": "device",
        "channel": "WS device",
        "action": "send schedule.result",
        "see": "schedules.create_full_week_with_night_setback_and_exceptions.ws_device_to_server_applied"
      }
    ],
    "publish_config": [
      {
        "step": 1,
        "actor": "app",
        "channel": "REST",
        "action": "POST configuration/versions then /publish",
        "see": "configuration.create_and_publish"
      },
      {
        "step": 2,
        "actor": "server",
        "channel": "WS device",
        "action": "push config.apply",
        "see": "configuration.create_and_publish.ws_server_to_device"
      },
      {
        "step": 3,
        "actor": "device",
        "channel": "WS device",
        "action": "send config.result",
        "see": "configuration.create_and_publish.ws_device_to_server_applied"
      },
      {
        "step": 4,
        "actor": "server",
        "channel": "WS app",
        "action": "push sync.status_changed",
        "see": "configuration.create_and_publish.ws_server_to_app"
      }
    ]
  }
